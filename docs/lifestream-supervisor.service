# Lifestream Supervisor systemd service
#
# Installation:
#   0. Build the venv: bin/setup
#   1. Copy this file, lifestream-notify-failure@.service and
#      lifestream-notify-failure-escalate@.service to /etc/systemd/system/
#   2. Edit the paths and user as needed
#   3. Run: sudo systemctl daemon-reload
#   4. Run: sudo systemctl enable lifestream-supervisor
#   5. Run: sudo systemctl start lifestream-supervisor
#
# Management:
#   sudo systemctl status lifestream-supervisor  # Check status
#   sudo systemctl restart lifestream-supervisor # Restart
#   journalctl -u lifestream-supervisor -f       # View logs

[Unit]
Description=Lifestream Supervisor (scheduler + webserver)
After=network.target redis.service mysql.service
Wants=redis.service
# If it keeps crashing, stop retrying and send an alert (bin/notify-failure)
# rather than restart-looping silently. 5 failures in an hour, with
# RestartSec=30, also catches a slow crash loop (one failure every few
# minutes) that a shorter window would let restart forever without alerting.
StartLimitIntervalSec=3600
StartLimitBurst=5
OnFailure=lifestream-notify-failure@%n.service

[Service]
Type=simple
User=aquarion
Group=aquarion
WorkingDirectory=/home/aquarion/code/lifestream

# Run the venv's Python directly. bin/setup builds .venv on a uv-managed
# Python rather than the distro's, so OS upgrades can't break it.
ExecStart=/home/aquarion/code/lifestream/.venv/bin/python supervisor.py

# `!`-prefixed schedule entries in config.ini run as `python`/`poetry` via a
# shell (src/lifestream/core/jobs.py's run_shell_command); without this they'd
# resolve against systemd's default PATH instead of the venv.
Environment=PATH=/home/aquarion/code/lifestream/.venv/bin:/usr/local/bin:/usr/bin:/bin

Restart=on-failure
RestartSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lifestream-supervisor

# Security hardening (optional but recommended)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/aquarion/code/lifestream/logs
ReadWritePaths=/home/aquarion/code/lifestream/keys
PrivateTmp=true

[Install]
WantedBy=multi-user.target
