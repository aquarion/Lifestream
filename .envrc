# Activate the project venv. It's built by bin/setup on a uv-managed Python,
# so OS upgrades don't break it. Run bin/setup after pulling dependency changes.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

if ! "$VIRTUAL_ENV/bin/python" -c "" 2> /dev/null; then
  log_error ".venv is missing or broken - run bin/setup"
fi
